# 默认使用 SQLite 演示；正式接入 MySQL 时改用 mysql+pymysql://用户名:密码@主机:3306/数据库名?charset=utf8mb4
DATABASE_URL=sqlite:///./database/assistant.db
COURSE_ZIP=knowledge_base/course_materials_latest.zip
COURSE_MATERIALS_DIR=course_materials
COURSE_MATERIALS_DIR=course_materials
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PORT=8001

# 在本机设置新生成的密钥；不要把真实密钥提交到仓库或发到聊天中。
QWEN_API_KEY=
QWEN_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# 教师工作台访问码，请在本机 .env 中设置随机值。
TEACHER_ACCESS_CODE=
MEDIA_SIGNING_KEY=
